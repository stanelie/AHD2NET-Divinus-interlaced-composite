<label><span data-i18n='osdEnabled'>OSD</span><select name='osd_enabled' disabled><option value='false' data-i18n='off'>Off</option><option value='true' data-i18n='on'>On</option></select></label>
<label><span data-i18n='osdText'>OSD text</span><input name='osd' maxlength='63' disabled></label>
<label><span data-i18n='osdPosition'>OSD position</span><select id='osd-position' disabled><option value='0,0' data-i18n='topLeft'>Top left</option><option value='1000,0' data-i18n='topRight'>Top right</option><option value='0,1000' data-i18n='bottomLeft'>Bottom left</option><option value='1000,1000' data-i18n='bottomRight' selected>Bottom right</option></select><input name='osd_x' type='hidden' value='1000'><input name='osd_y' type='hidden' value='1000'></label>
