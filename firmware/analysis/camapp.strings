<!doctype html>
<html lang='en'>
<head>
<meta charset='utf-8'>
<meta name='viewport' content='width=device-width,initial-scale=1'>
<title>Camera Management</title>
<link rel='stylesheet' href='/web/style.css'>
</head>
<body>
<section id='login-view' class='login-shell'>
<form id='login-form' class='login-panel'>
<h1 data-i18n='cameraManagement'>Camera Management</h1>
<label><span data-i18n='username'>Username</span><input name='username' value='admin' autocomplete='username' required autofocus></label>
<label><span data-i18n='password'>Password</span><input name='password' type='password' autocomplete='current-password'></label>
<button type='submit' data-i18n='signIn'>Sign in</button>
<div id='login-status' class='login-status' role='alert' aria-live='polite'></div>
</form>
</section>
<main id='app-view' hidden>
<section class='card'>
<div class='live-head'><div class='live-title'><h2 data-i18n='liveVideo'>Live fMP4</h2><span id='live-input-mode' hidden></span></div><label><span data-i18n='stream'>Stream</span><select id='live-stream'><option value='main' data-i18n='mainStream'>Main stream</option><option value='sub' data-i18n='subStream'>Sub stream</option></select></label></div>
<video id='v' autoplay muted playsinline controls></video>
<div id='stream' class='msg' data-i18n='loadingStream'>Loading stream...</div>
</section>
<aside class='manager' aria-label='Camera settings' data-i18n-label='cameraSettings'>
<div class='tablist' role='tablist' aria-label='Settings modules' data-i18n-label='settingsModules'>
