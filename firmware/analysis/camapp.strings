*{box-sizing:border-box}
body{margin:0;background:#181818;color:#cccccc;font:14px 'Segoe UI',Arial,sans-serif;color-scheme:dark}
[hidden]{display:none!important}
main{display:grid;grid-template-columns:minmax(0,2fr) minmax(380px,1fr);gap:1px;padding:0;min-height:100vh;background:#3c3c3c}
.login-shell{min-height:100vh;display:grid;place-items:center;padding:20px;background:#181818}
.login-panel{width:min(360px,100%);padding:24px;background:#1f1f1f;border:1px solid #3c3c3c;border-radius:0}
.login-panel h1{margin:0 0 20px;font-size:22px;font-weight:400;color:#ffffff}
.login-panel label{margin-bottom:12px}
.login-panel button{width:100%;margin-top:6px}
.login-status{min-height:20px;margin-top:10px;color:#f48771}
.card,.manager{background:#1f1f1f;border:0;border-radius:0;padding:14px;min-width:0}
.live-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}.live-title{display:flex;align-items:center;gap:10px;min-width:0}.live-head h2{margin:0}.live-title span{color:#4fc1ff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.live-head label{margin:0;flex-direction:row;align-items:center}.live-head select{width:132px}
video{width:100%;background:#000;max-height:calc(100vh - 70px)}
.tablist{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border-bottom:1px solid #3c3c3c;background:#181818}
[role=tab]{min-width:0;height:52px;padding:6px 4px;border:0;border-top:1px solid transparent;border-right:1px solid #2b2b2b;border-radius:0;background:#181818;color:#969696;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
[role=tab][aria-selected=true]{color:#ffffff;border-top-color:#007acc;background:#1f1f1f}
[role=tab]:focus-visible{outline:1px solid #007acc;outline-offset:-1px}
.tab-status{display:block;font-size:11px;color:#4fc1ff;overflow:hidden;text-overflow:ellipsis}
.panel-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:14px 0 10px}
.panel-head h3{margin:0}
.panel-meta{display:flex;align-items:center;gap:6px}
.panel-state{color:#4fc1ff}
.refresh-btn{width:36px;height:36px;padding:0;display:grid;place-items:center;font-size:18px;line-height:1}
[role=tabpanel][hidden]{display:none}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.grid .wide{grid-column:1/-1}
label{display:flex;flex-direction:column;gap:4px;min-width:0;color:#cccccc}
.grid label{justify-content:flex-end}
input,select,button{min-width:0;height:36px;padding:8px;background:#313131;color:#cccccc;border:1px solid #3c3c3c;border-radius:0;line-height:18px}
input:focus,select:focus{border-color:#007acc;outline:1px solid #007acc;outline-offset:-1px}
.grid input,.grid select{width:100%}
.grid input[type=number]{appearance:textfield;-moz-appearance:textfield}
.grid input[type=number]::-webkit-inner-spin-button,.grid input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}
button{cursor:pointer;background:#2d2d2d}
button:hover:not(:disabled){background:#3a3d41;border-color:#505050}
button:active:not(:disabled){background:#094771}
button:focus-visible{outline:1px solid #007acc;outline-offset:-1px}
button:disabled,input:disabled,select:disabled{cursor:not-allowed;opacity:.55}
.save{width:180px;justify-self:start;align-self:end;background:#0e639c;border-color:#0e639c;color:#ffffff}
.save:hover:not(:disabled){background:#1177bb;border-color:#1177bb}
.danger{background:#a1260d;border-color:#a1260d}
.danger:hover:not(:disabled){background:#c42b1c;border-color:#c42b1c}
.system-divider{grid-column:1/-1;border:0;border-top:1px solid #3c3c3c;width:100%;margin:8px 0 0}
.upgrade-control{grid-column:1/-1;display:grid;grid-template-columns:1fr;gap:8px}
.upgrade-control .save{justify-self:start}
.upgrade-modal{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:20px;background:rgba(0,0,0,.65)}
.upgrade-dialog{width:min(420px,100%);padding:20px;background:#252526;border:1px solid #3c3c3c;box-shadow:0 10px 32px rgba(0,0,0,.5)}
.upgrade-dialog progress{width:100%;height:36px;accent-color:#007acc}
.upgrade-percent{display:block;margin-top:8px;text-align:center;color:#ffffff}
.upgrade-status{margin-bottom:12px;color:#cccccc;text-align:center}
.dialog-modal{position:fixed;inset:0;z-index:1100;display:grid;place-items:center;padding:20px;background:rgba(0,0,0,.65)}
.dialog-panel{width:min(380px,100%);padding:20px;background:#252526;border:1px solid #3c3c3c;box-shadow:0 10px 32px rgba(0,0,0,.5)}
.dialog-text{min-height:22px;white-space:pre-wrap;color:#cccccc}
.dialog-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}
.ptz-controls{display:grid;grid-template-columns:auto auto;align-items:center;justify-content:center;gap:18px;margin-top:14px}
.dpad{display:grid;grid-template-columns:repeat(3,48px);grid-template-rows:repeat(3,48px);gap:4px}
.icon-btn{width:44px;height:44px;padding:0;display:grid;place-items:center;place-self:center;font-size:20px;line-height:1}
.move-up{grid-column:2}.move-left{grid-column:1;grid-row:2}.move-stop{grid-column:2;grid-row:2;font-size:30px}.move-right{grid-column:3;grid-row:2}.move-down{grid-column:2;grid-row:3}
.lens-controls{display:grid;gap:12px}
.ptz-pair{display:grid;grid-template-columns:repeat(2,44px);gap:6px}
.tool-icon{position:relative;display:grid;place-items:center;width:22px;height:22px;font-size:14px;font-weight:bold}
.zoom-icon{border:2px solid currentColor;border-radius:50%;margin:-4px 4px 4px -4px}
.zoom-icon:after{content:'';position:absolute;width:9px;height:2px;background:currentColor;right:-7px;bottom:-4px;transform:rotate(45deg)}
.focus-icon{border:2px solid currentColor;border-radius:50%;box-shadow:inset 0 0 0 4px #1f1f1f}
.msg{padding:8px 0;color:#4fc1ff;white-space:pre-wrap}
.error{color:#f48771}
@media(max-width:900px){main{grid-template-columns:1fr}.manager{min-width:0}}
@media(max-width:460px){.grid{grid-template-columns:1fr}.tablist{grid-template-columns:repeat(2,minmax(0,1fr))}}
